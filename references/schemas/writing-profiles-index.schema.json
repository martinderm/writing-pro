{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/martinderm/writing-pro/master/references/schemas/writing-profiles-index.schema.json",
  "title": "Writing profiles index",
  "description": "Vertrag fuer den YAML-Frontmatter-Block der writing-profiles/index.md (Discovery-SSOT). Die Eintraege sind eine gewollte Projektion der Profil-Frontmatters; der Validator prueft die Konsistenz der Projektion.",
  "type": "object",
  "required": ["type", "updated", "profiles"],
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "writing-profiles-index"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Datum der letzten Index-Aktualisierung (ISO 8601, YYYY-MM-DD)."
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "profile_id",
          "title",
          "owner",
          "language_variants",
          "genres",
          "profile_version",
          "status",
          "profile_path"
        ],
        "additionalProperties": false,
        "properties": {
          "profile_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "description": "Menschlich lesbarer Titel, entspricht der H1 des Profils."
          },
          "owner": {
            "type": "string",
            "description": "Profilinhaberin bzw. Profilinhaber oder Organisation (Label, keine Personenbeschreibung)."
          },
          "language_variants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z]{2}(-[A-Za-z]{2,4})?$"
            }
          },
          "genres": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "profile_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "status": {
            "enum": ["draft", "tested", "deprecated"]
          },
          "profile_path": {
            "type": "string",
            "description": "Workspace-relativer Pfad zur style-profile.md mit Vorwaertsslashes (z. B. writing-profiles/grant-applications/style-profile.md)."
          },
          "provenance_path": {
            "type": "string",
            "description": "Workspace-relativer Pfad zur provenance.json."
          }
        }
      }
    }
  }
}
